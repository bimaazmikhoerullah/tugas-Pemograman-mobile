<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_base_gradient"
    android:fitsSystemWindows="true">

    <include layout="@layout/view_mesh_background" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Floating glass navbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_glass_pill"
            android:elevation="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:outlineSpotShadowColor="#1A007AFF"
            android:paddingStart="10dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/buttonBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_glass_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:stateListAnimator="@animator/press_scale"
                android:text="‹"
                android:textColor="@color/ios_blue_deep"
                android:textSize="30sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Pesan Makanan"
                android:textColor="@color/ios_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_pill"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="AMAN"
                android:textColor="@color/ios_blue_deep"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="18dp"
                android:paddingEnd="16dp"
                android:paddingBottom="20dp">

                <!-- Glass ringkasan pesanan -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass"
                    android:elevation="6dp"
                    android:orientation="vertical"
                    android:outlineSpotShadowColor="#1A007AFF"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PESANAN KAMU"
                        android:textColor="@color/ios_blue_deep"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textViewOrderTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Pesan Makanan"
                        android:textColor="@color/ios_text"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Isi data di bawah ini untuk melanjutkan pesananmu."
                        android:textColor="@color/ios_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Glass form input -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:hint="Nama Pembeli"
                    app:boxBackgroundColor="@color/glass_fill_strong"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxStrokeColor="@color/glass_stroke"
                    app:boxStrokeWidth="1dp"
                    app:startIconDrawable="@drawable/ic_person"
                    app:startIconTint="@color/ios_blue_deep">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editTextCustomerName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        android:singleLine="true"
                        android:textColor="@color/ios_text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="Jumlah Pesanan"
                    app:boxBackgroundColor="@color/glass_fill_strong"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxStrokeColor="@color/glass_stroke"
                    app:boxStrokeWidth="1dp"
                    app:helperText="Maksimal 999 porsi"
                    app:startIconDrawable="@drawable/ic_quantity"
                    app:startIconTint="@color/ios_blue_deep">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editTextQuantity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:textColor="@color/ios_text" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Glass total card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_glass"
                    android:elevation="6dp"
                    android:orientation="vertical"
                    android:outlineSpotShadowColor="#1A007AFF"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TOTAL PEMBAYARAN"
                        android:textColor="@color/ios_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textViewTotalPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Rp 0"
                        android:textColor="@color/ios_blue_deep"
                        android:textSize="28sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:minHeight="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonConfirmOrder"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Konfirmasi Pesanan"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:stateListAnimator="@animator/press_scale"
                    app:backgroundTint="@color/ios_blue"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_bag"
                    app:iconGravity="textStart"
                    app:iconTint="@color/white" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="Terima kasih sudah berbelanja di Warungku 💙"
                    android:textColor="@color/ios_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</FrameLayout>
