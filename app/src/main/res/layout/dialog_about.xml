<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass"
    android:elevation="8dp"
    android:orientation="vertical"
    android:outlineSpotShadowColor="#1A007AFF"
    android:padding="22dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tentang Warungku"
        android:textColor="@color/ios_text"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="4dp"
        android:text="Warungku v1.0\nAntarmuka bergaya iOS Glassmorphism dengan palet biru–putih."
        android:textColor="@color/ios_secondary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/buttonDialogOk"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_primary_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:stateListAnimator="@animator/press_scale"
        android:text="OK"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
