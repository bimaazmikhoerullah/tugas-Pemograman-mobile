<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:background="@drawable/bg_glass"
    android:elevation="6dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:outlineSpotShadowColor="#1A007AFF"
    android:padding="14dp"
    android:stateListAnimator="@animator/press_scale">

    <ImageView
        android:id="@+id/imageViewFoodPhoto"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_photo_rounded"
        android:clipToOutline="true"
        android:contentDescription="@string/food_photo_desc"
        android:outlineProvider="background"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textViewFoodName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nama Makanan"
            android:textColor="@color/ios_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textViewFoodPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Rp 0"
            android:textColor="@color/ios_blue_deep"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Ketuk untuk detail"
            android:textColor="@color/ios_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="›"
        android:textColor="@color/ios_blue"
        android:textSize="28sp" />
</LinearLayout>
